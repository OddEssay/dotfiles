#:qghostty +list-themes
# theme = dark:SoftServer,light:SoftServer
# theme = matrix
# theme = lovelace
theme = Teerb

# Fallback for systems without xterm-ghostty terminfo
# term = xterm-256color

window-decoration = false
confirm-close-surface = false
# tmux auto-start is handled in zshrc

# Emit Shift+Enter as CSI-u so tmux can preserve the modifier for TUIs such as
# Codex and Claude Code.
keybind = shift+enter=text:\x1b[13;2u
